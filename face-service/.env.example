# Copy to .env and adjust. All values have sensible defaults.

# --- MongoDB ---
# No auth (fresh local/docker Mongo):
MONGO_URI=mongodb://localhost:27017
# With auth (your Mongo has a username/password) — note authSource:
# MONGO_URI=mongodb://USER:PASSWORD@localhost:27017/?authSource=admin
FACE_DB_NAME=rean_face_poc
# Real migrated collections (from sample-data). Face embeddings are stored
# separately so real student docs are never mutated.
FACE_STUDENTS_COLL=students
FACE_EMBEDDINGS_COLL=face_embeddings
FACE_ATTENDANCE_COLL=attendance
FACE_SUBJECTS_COLL=subjects

# --- InsightFace model ---
# buffalo_l = accurate (ArcFace r100, 512-d)   ·  buffalo_s = light/fast
MODEL_PACK=buffalo_l
DET_SIZE=640
DEVICE=cpu            # cpu | gpu  (gpu needs onnxruntime-gpu + CUDA)

# --- Matching ---
# cosine similarity threshold (0..1). Lower = stricter.
MATCH_THRESHOLD=0.25

# --- Anti-spoofing / liveness (presentation-attack detection) ---
# Rejects printed photos and faces shown on a screen. Instant rollback: set false.
ANTISPOOF_ENABLED=true
# Optional ONNX model (MiniFASNet / Silent-Face). If the file exists it is used;
# otherwise the built-in classical-CV detector runs. Drop weights here to upgrade.
ANTISPOOF_MODEL_PATH=models/antispoof.onnx
# Liveness probability cutoff (0..1, higher = stricter).
LIVENESS_THRESHOLD=0.65
ENROLL_LIVENESS_THRESHOLD=0.70
# Optional per-source overrides (kiosk is supervised → can be looser; phone tighter).
LIVENESS_THRESHOLD_KIOSK=
LIVENESS_THRESHOLD_PHONE=
# If the model errors at runtime: true = refuse (fail-closed), false = allow (fail-open).
ANTISPOOF_FAIL_CLOSED=true

# --- Session tokens ---
# HMAC key for signing login tokens. GENERATE YOUR OWN and keep it secret:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Leave unset only in dev: the service then signs with a random per-process key,
# so restarts log everyone out and tokens don't verify across uvicorn workers.
AUTH_SECRET=taBFVjdBwL0QYTFhHhGvy_QSuOdjyKglZv193pcU5pU
AUTH_TOKEN_TTL_HOURS=12


# How long a worker may serve its cached face gallery before re-checking Mongo
# for enrollments made by another worker (seconds). 0 = check every recognition.
GALLERY_STAMP_TTL=3

# --- API ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
